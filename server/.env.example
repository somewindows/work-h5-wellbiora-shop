# 应用
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# 认证：本地可使用任意至少 32 位随机值；生产环境必须替换为独立密钥。
JWT_SECRET=replace-with-a-long-random-secret-before-production
# 短信：真实服务商接入前的联调开关——生产环境显式置 1 才把验证码打印到后端日志（server-out.log）；正式上线前必须移除
#SMS_DEV_CONSOLE=1
# 个人敏感数据加密：必须是随机 32 字节密钥的 Base64 编码，生成示例：node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
PERSONAL_DATA_KEY=replace-with-a-base64-encoded-32-byte-key-before-production

# 后台首个管理员：仅在 admin_accounts 为空时创建。生产环境请使用随机且至少 12 位的强密码；创建成功后可从部署环境移除密码变量。
ADMIN_INITIAL_USERNAME=replace-with-an-admin-username
ADMIN_INITIAL_PASSWORD=replace-with-a-random-password-at-least-12-characters

# MySQL 8
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=wellbiora
MYSQL_PASSWORD=wellbiora_local_password
MYSQL_DATABASE=wellbiora_shop

# 后台管理员登录限频：窗口内连续失败达到上限后锁定（维度：IP + 账号）
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_LOCK_MINUTES=10

# ── 微信支付（配齐才启用真实支付；全部留空 = 本地 mock 支付；只配一半会启动报错）──
# 服务号 AppID 与公众号 AppSecret（微信开发者平台）
#WXPAY_APPID=
#WX_APPSECRET=
# 商户号 / 商户 API 证书序列号 / 证书私钥文件路径（生产：D:\www\wellbiora\certs\wechatpay\apiclient_key.pem）
#WXPAY_MCHID=
#WXPAY_SERIAL_NO=
#WXPAY_PRIVATE_KEY_PATH=
# APIv3 密钥（32 字节，回调解密用）；APIv2 密钥仅自助清关报关需要
#WXPAY_API_V3_KEY=
#WXPAY_API_V2_KEY=
# 微信支付公钥（回调验签用）：新商户号没有平台证书（/v3/certificates 回 RESOURCE_NOT_EXISTS），
# 必须到 商户平台 → 账户中心 → API安全 → 微信支付公钥 下载公钥文件并复制公钥 ID（PUB_KEY_ID_ 开头）。
# 两个变量必须同时配置；不配则走旧的拉平台证书模式。
#WXPAY_PUBLIC_KEY_PATH=D:\www\wellbiora\certs\wechatpay\pub_key.pem
#WXPAY_PUBLIC_KEY_ID=PUB_KEY_ID_0114XXXXXXXXXXXXXXXXXXXXXXXX
# 支付结果回调（公网 https）；退款回调缺省由支付回调推导 /refund-notify
#WXPAY_NOTIFY_URL=https://wellbiora.com.cn/api/v1/payments/wechat/notify
#WXPAY_REFUND_NOTIFY_URL=
# 海关报关（自助清关开通后配置）：海关代码（商户平台已添加「杭州（总署版）」→ HANGZHOU_ZS）+ 商户海关备案号
#WXPAY_CUSTOMS_CODE=HANGZHOU_ZS
#WXPAY_MCH_CUSTOMS_NO=5101960X8F
